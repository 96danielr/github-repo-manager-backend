# Copy to .env for local development. Never commit real values.

# Server
NODE_ENV=development
PORT=5000

# Database (local MongoDB for development; never point this at production)
MONGODB_URI=mongodb://127.0.0.1:27017/operix_dev

# JWT (long random values, different from each other and from every other environment)
JWT_SECRET=change-me
JWT_EXPIRE=8h
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRE=7d

# Public URLs: the app (validation links) and this API (receipts and statements)
FRONTEND_URL=http://localhost:3002
API_URL=http://localhost:5000
# Extra CORS origins, comma separated (optional)
ALLOWED_ORIGINS=

# Cookies (leave unset unless the API is served over HTTPS)
COOKIE_SECURE=

# Notifications: nothing is sent unless ENABLE_NOTIFICATIONS=true
ENABLE_NOTIFICATIONS=false
# whatsapp: meta | dummy  ·  email: resend | sendme | dummy
WHATSAPP_PROVIDER=dummy
EMAIL_PROVIDER=dummy
EMAIL_FROM=Operix Desarrollo <dev@operix.com.co>
RESEND_API_KEY=
SENDME_API_KEY=

# Meta WhatsApp Cloud API (used when WHATSAPP_PROVIDER=meta and by the WhatsApp inbox)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0
META_CONFIG_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=

# Cloudflare R2 (each environment has its own bucket)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# AI assistant (optional: without it /api/ai/ask answers 503)
GEMINI_API_KEY=

# ElevenLabs voice agent tools (paused; set a long random value in every deployed environment)
ELEVENLABS_WEBHOOK_SECRET=
