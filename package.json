{
  "name": "mis-finanzas-api",
  "version": "1.0.0",
  "description": "Personal Finance Manager API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "set NODE_OPTIONS=--dns-result-order=ipv4first && nodemon server.js",
    "dev:unix": "NODE_OPTIONS=--dns-result-order=ipv4first nodemon server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "seed:test-users": "node seed-test-users.js",
    "migrate:receipts": "node src/scripts/migrateReceiptNumbers.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --runInBand"
  },
  "keywords": [
    "api",
    "finance",
    "personal-finance",
    "budgeting"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1013.0",
    "@langchain/core": "^1.1.39",
    "@langchain/google-genai": "^2.1.26",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.3.1",
    "moment": "^2.30.1",
    "mongoose": "^8.1.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "multer-s3-v3": "^33.0.12",
    "node-sql-parser": "^5.4.0",
    "pdfkit": "^0.18.0",
    "resend": "^6.10.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^30.3.0",
    "nodemon": "^3.0.3",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
